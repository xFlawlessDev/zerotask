{
  "name": "@zerotask/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:seed": "bun src/db/seed.ts",
    "db:reset": "bun src/db/reset.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@elysiajs/cors": "^1.4.2",
    "@sinclair/typebox": "^0.34.52",
    "@zerotask/domain": "workspace:*",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "postgres": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^0.31.11",
    "typescript": "5.9.3"
  }
}
