{
  "name": "zerotask",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "typecheck": "bun run --cwd packages/domain typecheck && bun run --cwd apps/api typecheck && bun run --cwd apps/web typecheck",
    "test": "bun run --cwd apps/api test",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "db:seed": "bun run --cwd apps/api db:seed",
    "db:reset": "bun run --cwd apps/api db:reset",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "5.9.3"
  }
}
