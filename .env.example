# --- API ---

# Port the API listens on.
PORT=3400

# Comma separated list of origins allowed to call the API.
WEB_ORIGIN=http://localhost:5183

# Postgres connection string. When empty, the API runs on an embedded PGlite
# database persisted in apps/api/.data, which needs no server.
DATABASE_URL=

# Directory used by the embedded database when DATABASE_URL is empty.
PGLITE_DIR=.data/pg

# Secret used to sign sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3400

# Disable the background email worker (emails are also written to the outbox table).
EMAIL_WORKER_ENABLED=true

# --- WEB ---

# Base URL of the API as seen from the browser. Leave empty to use the dev proxy.
VITE_API_URL=http://localhost:3400
